<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org" class="in-text" version="1.0" default-locale="en-US">
  <info>
    <title>Custom Brackets Initial First Style Final</title>
    <id>http://zotero.org</id>
    <link href="http://zotero.org" rel="self"/>
    <author>
      <name>Mendeley Fix</name>
    </author>
    <category citation-format="numeric"/>
    <updated>2026-08-06T12:00:00+00:00</updated>
  </info>
  
  <macro name="author">
    <names variable="author">
      <name initialize-with=". " delimiter=", " and="text" name-as-sort-order="all" sort-separator=" " et-al-min="4" et-al-use-first="3"/>
      <et-al term="et-al"/>
    </names>
  </macro>

  <macro name="title">
    <text variable="title" quotes="true"/>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <citation>
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography entry-spacing="1">
    <layout>
      <text variable="citation-number" suffix=". "/>
      <text macro="author" suffix=", "/>
      <text macro="title" suffix=", "/>
      <text variable="container-title" suffix=" "/>
      <text variable="volume"/>
      <text variable="issue" prefix=", no. "/>
      <text macro="issued" prefix=" (" suffix="): "/>
      <text variable="page"/>
    </layout>
  </bibliography>
</style>
