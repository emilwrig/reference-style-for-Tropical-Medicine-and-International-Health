<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://citeproc.org" class="in-text" version="1.0" default-locale="en-US">
  <info>
    <title>Custom Brackets and Initial-First Style</title>
    <id>http://zotero.org</id>
    <link href="http://zotero.org" rel="self"/>
    <author>
      <name>Custom Generator</name>
    </author>
    <category citation-format="numeric"/>
    <updated>2026-08-06T12:00:00+00:00</updated>
  </info>
  
  <macro name="author">
    <names variable="author">
      <name initialize-with=". " delimiter=", " and="text" givenname-at-the-beginning="true" et-al-min="4" et-al-use-first="3"/>
      <et-al term="et-al" font-style="normal"/>
    </names>
  </macro>

  <citation>
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography entry-spacing="1" second-field-align="flush">
    <layout>
      <text variable="citation-number" suffix=". "/>
      <group delimiter=", ">
        <text macro="author"/>
        <text variable="title" quotes="true"/>
        <group delimiter=" ">
          <text variable="container-title" font-style="normal"/>
          <text variable="volume"/>
        </group>
      </group>
      <group prefix=", no. " suffix=" ">
        <text variable="issue"/>
      </group>
      <group prefix="(" suffix="): ">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </group>
      <text variable="page"/>
    </layout>
  </bibliography>
</style>
